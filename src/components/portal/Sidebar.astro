---
interface Props { active: string; }
const { active } = Astro.props;

// href: null = not built yet (shown, marked "Soon", not clickable)
const items = [
  { key: 'dashboard', label: 'Dashboard', href: '/portal/dashboard', icon: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>' },
  { key: 'leads', label: 'Leads', href: null, icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.8c1.7.8 2.8 2.6 3 5.2"/>' },
  { key: 'messages', label: 'Messages', href: null, icon: '<path d="M4 5h16v11H9l-5 4z" stroke-linejoin="round"/>' },
  { key: 'calendar', label: 'Calendar', href: null, icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  { key: 'blog', label: 'Blog', href: null, icon: '<path d="M6 3h9l4 4v14H6z" stroke-linejoin="round"/><path d="M14 3v5h5M9 12h7M9 16h7"/>' },
  { key: 'campaigns', label: 'Campaigns', href: null, icon: '<path d="M3 10v4h3l6 4V6L6 10z" stroke-linejoin="round"/><path d="M16 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11"/>' },
];
---
<nav class="ps" aria-label="Portal">
  <a class="ps__brand" href="/portal/dashboard">
    <img src="/images/DD-Logo-icon.png" alt="" width="36" height="36" />
    <span><strong>Design Dentistry</strong><small>Staff Portal</small></span>
  </a>
  <ul class="ps__nav">
    {items.map((it) => (
      <li>
        {it.href ? (
          <a href={it.href} class:list={['ps__link', { 'is-on': it.key === active }]} aria-current={it.key === active ? 'page' : undefined}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={it.icon} />
            {it.label}
          </a>
        ) : (
          <span class="ps__link is-soon" aria-disabled="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={it.icon} />
            {it.label}
            <span class="ps__soon">Soon</span>
          </span>
        )}
      </li>
    ))}
  </ul>
  <div class="ps__foot">
    <div class="ps__me">
      <span class="ps__avatar" data-user-initials></span>
      <span class="ps__who"><strong data-user-name></strong><small data-user-role></small></span>
    </div>
    <button type="button" class="ps__signout" data-sign-out>Sign out</button>
  </div>
</nav>

<style>
  .ps { flex: 0 0 240px; min-height: 100vh; padding: 24px 16px; background: #fff; border-right: 1px solid var(--p-line); display: flex; flex-direction: column; gap: 28px; }
  .ps__brand { display: flex; align-items: center; gap: 10px; padding: 0 6px; text-decoration: none; color: var(--p-text); }
  .ps__brand span { display: flex; flex-direction: column; line-height: 1.15; }
  .ps__brand strong { font-size: 15px; }
  .ps__brand small { font-size: 12px; font-weight: 500; color: var(--p-muted); }
  .ps__nav { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .ps__link { display: flex; align-items: center; gap: 12px; height: 44px; padding: 0 14px; border-radius: 10px; color: var(--p-text-2); text-decoration: none; font-size: 15px; font-weight: 500; }
  a.ps__link:hover { background: #eef3f6; color: var(--p-text); }
  .ps__link.is-on { background: var(--p-blue-soft); color: var(--p-blue); font-weight: 600; }
  .ps__link.is-soon { color: #8a959b; cursor: default; }
  .ps__soon { margin-left: auto; font-size: 11px; font-weight: 600; letter-spacing: .03em; color: var(--p-muted); background: var(--p-line-soft); padding: 2px 8px; border-radius: 999px; }
  .ps__foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; }
  .ps__me { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 12px; background: var(--p-bg); }
  .ps__avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--p-blue); color: #fff; font-size: 13px; font-weight: 600; display: grid; place-items: center; }
  .ps__who { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .ps__who strong { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ps__who small { font-size: 12px; color: var(--p-muted); }
  .ps__signout { height: 40px; border: 0; background: none; color: var(--p-muted); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; border-radius: 10px; }
  .ps__signout:hover { background: #eef3f6; color: var(--p-text); }

  @media (max-width: 860px) {
    .ps { flex: 1 1 100%; min-height: 0; padding: 12px 16px; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12px; border-right: 0; border-bottom: 1px solid var(--p-line); }
    .ps__nav { flex: 1 1 100%; flex-direction: row; overflow-x: auto; order: 3; }
    .ps__link { white-space: nowrap; }
    .ps__link.is-soon { display: none; }
    .ps__foot { margin: 0 0 0 auto; flex-direction: row; align-items: center; }
    .ps__me { display: none; }
  }
</style>
