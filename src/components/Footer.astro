---
import { SITE } from '../data/site';
const year = new Date().getFullYear();

const quick = [
  { label: 'Home', href: '/' },
  { label: 'Meet Dr. Ike', href: '/Isaiahdavis' },
  { label: 'Our Team', href: '/team' },
  { label: 'Real Stories', href: '/testimonials' },
  { label: 'Before & After', href: '/realresults' },
  { label: 'Financing Options', href: '/financing-options' },
  { label: 'Blog', href: '/blog' },
  { label: 'Location', href: '/location' },
  { label: 'Contact', href: '/contact' },
];
const services = [
  { label: 'Cosmetic Dentistry', href: '/cosmetic-dentistry' },
  { label: 'Dental Veneers', href: '/dental-veneers' },
  { label: 'Teeth Whitening', href: '/teeth-whitening' },
  { label: 'Dental Implants', href: '/implants' },
  { label: 'Full Arch Implants', href: '/full-arch-dental-implants' },
  { label: 'Dental Crowns', href: '/crowns' },
  { label: 'Dental Bridges', href: '/dental-bridges' },
  { label: 'General Dentistry', href: '/general-dentistry' },
  { label: 'Hygiene & Cleanings', href: '/hygiene' },
  { label: 'Root Canal Therapy', href: '/rootcanal-therapy' },
  { label: 'Tooth Fillings', href: '/Tooth-Fillings' },
  { label: 'Tooth Extractions', href: '/tooth-extractions' },
];
---
<footer class="site-footer">
  <div class="site-footer__photo" style="background-image:url('/images/DJI_0422.jpg')"></div>

  <div class="wrap site-footer__grid">
    <div class="col col--brand">
      <a class="brand" href="/" aria-label="Design Dentistry Columbia home">
        <img src="/images/DD-Logo-icon.png" alt="" width="56" height="56" loading="lazy" />
        <span>Design Dentistry<small>Columbia</small></span>
      </a>
      <p class="blurb">Cosmetic and general dentistry in Columbia, SC, with state-of-the-art technology and restorative services for families of all sizes.</p>
      <div class="socials">
        <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 8h3V4h-3c-2.8 0-4 1.7-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6z"/></svg>
        </a>
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21.9 8.2c-.1-1.5-.4-2.9-1.5-4s-2.5-1.4-4-1.5C14.8 2.6 9.2 2.6 7.6 2.7c-1.5.1-2.9.4-4 1.5S2.2 6.7 2.1 8.2C2 9.8 2 15.2 2.1 16.8c.1 1.5.4 2.9 1.5 4s2.5 1.4 4 1.5c1.6.1 7.2.1 8.8 0 1.5-.1 2.9-.4 4-1.5s1.4-2.5 1.5-4c.1-1.6.1-7 0-8.6zm-2.1 10.4a3.3 3.3 0 0 1-1.9 1.9c-1.3.5-4.4.4-5.9.4s-4.6.1-5.9-.4a3.3 3.3 0 0 1-1.9-1.9c-.5-1.3-.4-4.4-.4-5.9s-.1-4.6.4-5.9a3.3 3.3 0 0 1 1.9-1.9c1.3-.5 4.4-.4 5.9-.4s4.6-.1 5.9.4a3.3 3.3 0 0 1 1.9 1.9c.5 1.3.4 4.4.4 5.9s.1 4.6-.4 5.9z"/></svg>
        </a>
        <a href={SITE.mapsUrl} target="_blank" rel="noopener" aria-label="Google reviews">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.6 10.2H12v3.9h5.5c-.5 2.5-2.7 4.1-5.5 4.1a6.2 6.2 0 1 1 4-10.9l2.9-2.8A10.2 10.2 0 1 0 12 22.2c5.9 0 9.8-4.1 9.8-9.9 0-.7-.1-1.4-.2-2.1z"/></svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7.2L4.6 7H19.4zM4 8.9V17h16V8.9l-8 5.6z"/></svg>
        </a>
      </div>
    </div>

    <nav class="col" aria-label="Quick links">
      <h2>Quick Links</h2>
      <ul>{quick.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav class="col col--services" aria-label="Services">
      <h2>Our Services</h2>
      <ul>{services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <div class="col col--contact">
      <h2>Contact Us</h2>
      <ul class="contact">
        <li>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <a href={SITE.phoneHref}>(803) 667-3919</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7.2L4.6 7H19.4zM4 8.9V17h16V8.9l-8 5.6z"/></svg>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          <a href={SITE.mapsUrl} target="_blank" rel="noopener">126 Professional Park Rd<br />Columbia, SC 29229</a>
        </li>
      </ul>
      <dl class="hours">
        <dt>Mon – Thu</dt><dd>8am – 5pm</dd>
        <dt>Friday</dt><dd>8am – 12pm</dd>
        <dt>Sat – Sun</dt><dd>Closed</dd>
      </dl>
      <a class="btn btn--sm" href="/contact">Book an Appointment</a>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="wrap">© {year} {SITE.name}. All rights reserved.</div>
  </div>
</footer>

<style>
  .site-footer { position: relative; color: rgba(255,255,255,.82); background: #172227; overflow: hidden; font-size: 16px; }
  .site-footer__photo { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: .12; }
  .site-footer__grid {
    position: relative; display: grid; grid-template-columns: 1.15fr .8fr 1.7fr 1.25fr; gap: 40px 40px;
    padding-top: clamp(52px, 7vw, 84px); padding-bottom: clamp(44px, 6vw, 68px);
  }
  .site-footer h2 { font-family: var(--f-head); font-size: 16px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: #fff; margin: 6px 0 20px; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin: 0 0 10px; line-height: 1.4; }
  .site-footer a { color: rgba(255,255,255,.82); text-decoration: none; }
  .site-footer a:hover { color: var(--green); }

  .brand { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .brand img { width: 56px; height: 56px; }
  .brand span { font-family: var(--f-head); font-size: 26px; color: #fff; line-height: 1; }
  .brand small { display: block; font-size: 14px; letter-spacing: .3em; text-transform: uppercase; color: var(--green); margin-top: 6px; }
  .blurb { line-height: 1.6; margin: 0 0 22px; max-width: 320px; }
  .socials { display: flex; gap: 10px; }
  .socials a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.55); color: #fff; }
  .socials a:hover { background: var(--green); border-color: var(--green); color: #fff; }

  .col--services ul { columns: 2; column-gap: 24px; }
  .col--services a { white-space: nowrap; }
  .col--services li { break-inside: avoid; }

  .contact li { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; }
  .contact svg { flex: none; color: var(--green); margin-top: 2px; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 4px 18px; margin: 18px 0 22px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.14); }
  .hours dt { color: #fff; }
  .hours dd { margin: 0; }
  .site-footer .btn { color: #fff; }

  .site-footer__bottom { position: relative; border-top: 1px solid rgba(255,255,255,.1); background: var(--blue); color: #fff; font-size: 14px; padding: 14px 0; }

  @media (max-width: 1100px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .col--services ul { columns: 2; }
  }
</style>
