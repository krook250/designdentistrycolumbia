---
import { SITE, NAV_LEFT, NAV_RIGHT, type NavItem } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (item: NavItem): boolean =>
  (!!item.href && item.href === path) || (item.children?.some(isActive) ?? false);
---
<header class="site-header">
  <div class="site-header__bar">
    <a class="logo" href="/" aria-label="Design Dentistry Columbia home">
      <img src="/images/DD-Logo-horizontal-withouttag.png" alt="Design Dentistry Columbia" width="220" height="56" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__group">
        {NAV_LEFT.map((item) => (
          <li class={`nav__item${item.children ? ' has-menu' : ''}${isActive(item) ? ' is-active' : ''}`}>
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <button type="button" aria-haspopup="true">{item.label}<svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg></button>
            )}
            {item.children && (
              <div class={`menu${item.children.some((c) => c.children) ? ' menu--mega' : ''}`}>
                {item.children.some((c) => c.children) ? (
                  item.children.map((col) => (
                    <div class="menu__col">
                      <p class="menu__title">{col.label}</p>
                      <ul>{col.children?.map((c) => <li><a href={c.href} class={c.href === path ? 'is-current' : ''}>{c.label}</a></li>)}</ul>
                    </div>
                  ))
                ) : (
                  <ul>{item.children.map((c) => <li><a href={c.href} class={c.href === path ? 'is-current' : ''}>{c.label}</a></li>)}</ul>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>

      <a class="nav__mark" href="/" aria-label="Home">
        <img src="/images/DD-Logo-icon.png" alt="" width="64" height="64" />
      </a>

      <ul class="nav__group">
        {NAV_RIGHT.map((item) => (
          <li class={`nav__item${isActive(item) ? ' is-active' : ''}`}><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-cta">
      <a class="header-cta__phone" href={SITE.phoneHref}>{SITE.phone}</a>
      <a class="btn btn--sm header-cta__book" href="/contact">BOOK NOW</a>
    </div>

    <a class="mobile-call" href={SITE.phoneHref} aria-label={`Call ${SITE.phone}`}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
    </a>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="drawer" id="drawer" hidden>
    <ul>
      {[...NAV_LEFT, ...NAV_RIGHT].map((item) =>
        item.children ? (
          <li>
            <details>
              <summary>{item.label}</summary>
              {item.children.some((c) => c.children) ? (
                item.children.map((col) => (
                  <div class="drawer__col">
                    <p class="menu__title">{col.label}</p>
                    <ul>{col.children?.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
                  </div>
                ))
              ) : (
                <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
              )}
            </details>
          </li>
        ) : (
          <li><a href={item.href}>{item.label}</a></li>
        )
      )}
    </ul>
    <a class="btn" href="/contact">BOOK NOW</a>
    <a class="drawer__phone" href={SITE.phoneHref}>{SITE.phone}</a>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const drawer = document.getElementById('drawer');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
    document.body.classList.toggle('drawer-open', !open);
  });
  // Dropdowns open on hover (CSS) and on click/keyboard for touch + a11y
  document.querySelectorAll<HTMLButtonElement>('.nav__item.has-menu > button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.parentElement!;
      const open = li.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      document.querySelectorAll('.nav__item.is-open').forEach((o) => { if (o !== li) o.classList.remove('is-open'); });
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav__item.has-menu')) document.querySelectorAll('.nav__item.is-open').forEach((o) => o.classList.remove('is-open'));
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 1000; background: #fff; box-shadow: 0 1px 0 rgba(0,0,0,.06); }
  .site-header__bar {
    display: flex; align-items: center; gap: 24px;
    height: var(--header-h);
    max-width: 1440px; margin: 0 auto; padding: 0 clamp(16px, 2.5vw, 32px);
  }
  .logo img { width: clamp(170px, 15vw, 220px); height: auto; }
  .nav { flex: 1; display: flex; align-items: center; justify-content: center; gap: clamp(16px, 2.5vw, 44px); }
  .nav__group { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 40px); list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__item > a, .nav__item > button {
    font-family: var(--f-head); font-size: 18px; color: var(--green);
    text-decoration: none; background: none; border: 0; padding: 8px 0; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    border-bottom: 2px solid transparent;
  }
  .nav__item > a:hover, .nav__item > button:hover, .nav__item.is-active > a, .nav__item.is-active > button { border-bottom-color: var(--green); }
  .nav__mark img { width: 64px; height: 64px; }

  .menu {
    position: absolute; top: 100%; left: -20px; min-width: 240px;
    background: #fff; border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 14px 34px rgba(0,0,0,.12); border-top: 3px solid var(--green);
    padding: 14px 0; opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
  }
  .menu--mega { display: grid; grid-template-columns: repeat(3, 230px); gap: 8px; padding: 22px 12px; left: -120px; }
  .nav__item:hover > .menu, .nav__item:focus-within > .menu, .nav__item.is-open > .menu { opacity: 1; visibility: visible; transform: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { display: block; padding: 8px 20px; font-family: var(--f-head); font-size: 16px; color: var(--blue); text-decoration: none; }
  .menu a:hover, .menu a.is-current { background: var(--soft); color: var(--green); }
  .menu__title { font-family: var(--f-head); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; padding: 0 20px; }

  .header-cta { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .header-cta__phone { font-family: var(--f-head); font-size: 18px; color: var(--green); text-decoration: none; letter-spacing: .02em; }
  .header-cta__book { font-size: 20px; padding: 9px 34px; }

  .mobile-call, .burger { display: none; }
  .drawer { display: none; }

  @media (max-width: 1180px) {
    .nav, .header-cta { display: none; }
    .site-header__bar { justify-content: space-between; height: 76px; }
    .mobile-call { display: grid; place-items: center; margin-left: auto; width: 44px; height: 44px; border-radius: 50%; background: var(--green); color: #fff; }
    .burger { display: grid; gap: 5px; width: 44px; height: 44px; place-content: center; background: none; border: 0; cursor: pointer; }
    .burger span { display: block; width: 26px; height: 3px; background: var(--blue); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
    .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
    .drawer:not([hidden]) {
      display: block; position: fixed; inset: 76px 0 0 0; overflow-y: auto;
      background: #fff; padding: 12px 20px 40px; border-top: 1px solid var(--line);
    }
    .drawer > ul { list-style: none; margin: 0 0 24px; padding: 0; }
    .drawer li { border-bottom: 1px solid var(--line); }
    .drawer a, .drawer summary { display: block; padding: 14px 4px; font-family: var(--f-head); font-size: 20px; color: var(--blue); text-decoration: none; cursor: pointer; }
    .drawer details ul { list-style: none; margin: 0 0 8px; padding: 0 0 0 14px; }
    .drawer details li { border: 0; }
    .drawer details a { font-size: 17px; padding: 8px 4px; }
    .drawer .menu__title { padding: 8px 0 0 14px; }
    .drawer .btn { display: block; text-align: center; }
    .drawer__phone { text-align: center; color: var(--green) !important; }
  }
  :global(body.drawer-open) { overflow: hidden; }
</style>
