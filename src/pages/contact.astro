---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../data/site';
---
<Base title="Contact Us" description="Contact page for Design Dentistry to help with all of your dental needs.">
  <Hero image="/images/DSC_9459.jpg">
    <h1>Book your appointment today!</h1>
  </Hero>

  <section class="section">
    <div class="wrap contact">
      <div class="contact__info">
        <h2 class="blue">Office Hours</h2>
        <dl class="hours">
          {SITE.hours.map(([d, h]) => (<><dt>{d}</dt><dd>{h}</dd></>))}
        </dl>
        <h2 class="blue">Phone Number</h2>
        <p class="big"><a href={SITE.phoneHref}>(803) 667-3919</a></p>
        <h2 class="blue">Address</h2>
        <p class="big"><a href={SITE.mapsUrl} target="_blank" rel="noopener">126 Professional Park Rd<br />Columbia, SC 29229</a></p>
        <p><a href="/location">Directions to our office →</a></p>
      </div>

      <div class="contact__form" id="Contactus">
        <h2 class="green">Get in touch.</h2>
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/DCmlwEbDGQQTOBe2o0VX"
          style="width:100%;height:100%;min-height:520px;border:none;border-radius:8px"
          id="inline-DCmlwEbDGQQTOBe2o0VX"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Form 4"
          data-height="434"
          data-layout-iframe-id="inline-DCmlwEbDGQQTOBe2o0VX"
          data-form-id="DCmlwEbDGQQTOBe2o0VX"
          title="Contact form"></iframe>
        <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <h2 class="center">Reviews</h2>
      <script is:inline src="https://apps.elfsight.com/p/platform.js" defer></script>
      <div class="elfsight-app-99d0b13f-90fc-47bc-a22b-3d9599f83588"></div>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .contact__info h2 { font-size: 28px; margin-top: 1.2em; }
  .contact__info h2:first-child { margin-top: 0; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 6px 28px; margin: 0; font-family: var(--f-head); font-size: 19px; }
  .hours dt { font-weight: 500; }
  .hours dd { margin: 0; }
  .big { font-family: var(--f-head); font-size: 24px; }
  .big a { text-decoration: none; }
  .contact__form { background: var(--soft); border-radius: var(--radius); padding: clamp(20px, 3vw, 36px); }
</style>
