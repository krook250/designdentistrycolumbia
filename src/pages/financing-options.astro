---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
const partners = [
  { name: 'Proceed Finance', img: '/images/img-proceed-logo.png', href: 'https://www.proceedfinance.com/application/verify-email?t=web&referrer=713c71da-3b65-4cac-8b8d-9f1b958e619b' },
  { name: 'Cherry', img: '/images/img-cherry-logo.png', href: 'https://pay.withcherry.com/design-dentistry-columbia?utm_source=merchant&utm_medium=website' },
  { name: 'Affirm', img: '/images/img-affirm-logo.png', href: 'https://shop.designdentistrycolumbia.instapaytient.com/' },
];
---
<Base title="Financing Options - Design Dentistry Columbia" description="Payment plans and financing options at Design Dentistry Columbia. See if you qualify with Proceed Finance, Cherry or Affirm.">
  <Hero image="/images/Dental-Financial-Option.jpg">
    <h1>Financing Partners</h1>
    <p>Payment plans &amp; options</p>
  </Hero>
  <section class="section">
    <div class="wrap center">
      <h2 class="blue">See if you qualify; apply below</h2>
      <div class="partners">
        {partners.map((p) => (
          <a class="partner" href={p.href} target="_blank" rel="noopener">
            <img src={p.img} alt={`${p.name} - See if you qualify`} loading="lazy" />
            <span class="btn btn--sm">Apply with {p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <!-- Cherry financing widget (as on Duda) -->
      <script is:inline>
        (function (w, d, s, o, f, js, fjs) { w[o] = w[o] || function () { (w[o].q = w[o].q || []).push(arguments); }; (js = d.createElement(s)), (fjs = d.getElementsByTagName(s)[0]); js.id = o; js.src = f; js.async = 1; fjs.parentNode.insertBefore(js, fjs); })(window, document, 'script', '_hw', 'https://files.withcherry.com/widgets/widget.js');
        _hw('init', { debug: false, variables: { slug: 'design-dentistry-columbia', name: 'Design Dentistry Columbia', images: [21], customLogo: '', defaultPurchaseAmount: 2000, customImage: '', imageCategory: 'dental', language: 'en' }, styles: { primaryColor: '#5ca645', secondaryColor: '#5ca64510', fontFamily: 'Montserrat', headerFontFamily: 'Montserrat' } }, ['hero', 'calculator', 'howitworks', 'faq']);
      </script>
      <div id="all"></div>
      <div id="hero"></div>
      <div id="calculator"></div>
      <div id="howitworks"></div>
      <div id="testimony"></div>
      <div id="faq"></div>
    </div>
  </section>
</Base>
<style>
  .partners { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 36px; }
  @media (max-width: 820px) { .partners { grid-template-columns: 1fr; } }
  .partner { display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 32px 24px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: box-shadow .2s ease; }
  .partner:hover { box-shadow: 0 10px 28px rgba(0,0,0,.08); }
  .partner img { height: 70px; width: auto; object-fit: contain; }
</style>
