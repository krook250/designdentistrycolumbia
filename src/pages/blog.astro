---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).sort((a, b) => +b.date - +a.date);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'America/New_York' });
---
<Base title="Blog - Design Dentistry Columbia" description="Articles from Design Dentistry Columbia on cosmetic, restorative and general dentistry in Columbia, SC.">
  <section class="section">
    <div class="wrap">
      <h1 class="center blue">Blog</h1>
      <div class="grid grid--3" style="margin-top:36px">
        {posts.map((p, i) => (
          <a class="card" href={`/${p.slug}`}>
            <div class="card__img">{p.image ? <img src={p.image} alt="" loading={i < 6 ? 'eager' : 'lazy'} /> : <img src="/images/DD-Logo-icon.png" alt="" class="card__placeholder" loading="lazy" />}</div>
            <div class="card__body">
              <p class="card__meta">{fmt(p.date)}</p>
              <h3>{p.title}</h3>
              {p.description && <p>{p.description.length > 150 ? p.description.slice(0, 150).replace(/\s+\S*$/, '') + '…' : p.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .card__placeholder { object-fit: contain !important; padding: 18%; opacity: .5; }
</style>
