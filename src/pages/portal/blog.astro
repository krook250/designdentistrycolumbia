---
import PortalApp from '../../layouts/PortalApp.astro';
---
<PortalApp title="Blog" active="blog">
  <header class="p-pagehead">
    <div>
      <h1>Blog</h1>
      <p>Posts on designdentistrycolumbia.com</p>
    </div>
    <a class="p-btn p-btn--primary" href="/portal/post">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      New post
    </a>
  </header>

  <div class="bar">
    <div class="tabs" role="tablist" aria-label="Post status" data-tabs>
      <button type="button" role="tab" data-tab="all" aria-selected="true">All <span data-count="all"></span></button>
      <button type="button" role="tab" data-tab="published" aria-selected="false">Published <span data-count="published"></span></button>
      <button type="button" role="tab" data-tab="drafts" aria-selected="false">Drafts <span data-count="drafts"></span></button>
      <button type="button" role="tab" data-tab="scheduled" aria-selected="false">Scheduled <span data-count="scheduled"></span></button>
    </div>
    <label class="search">
      <span class="sr-only">Search posts</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5B6870" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input class="p-input" type="search" placeholder="Search posts" data-q />
    </label>
  </div>

  <section class="p-panel" aria-label="Posts">
    <div class="p-alert p-alert--error" role="alert" hidden data-error style="margin:16px 20px"></div>
    <ul class="posts" data-posts aria-live="polite"></ul>
    <div class="p-empty" hidden data-empty><strong>No posts here yet</strong><span>Write one with New post.</span></div>
    <div class="pager">
      <span data-range></span>
      <span style="display:flex;gap:8px">
        <button type="button" class="p-btn p-btn--sm" data-prev>Previous</button>
        <button type="button" class="p-btn p-btn--sm" data-next>Next</button>
      </span>
    </div>
  </section>
</PortalApp>

<style>
  .bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; background: #eaeff2; padding: 4px; border-radius: 12px; }
  .tabs button { height: 36px; padding: 0 14px; border: 0; border-radius: 9px; background: transparent; font: inherit; font-size: 14px; font-weight: 600; color: var(--p-text); cursor: pointer; }
  .tabs button[aria-selected='true'] { background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .tabs span { color: var(--p-muted); font-weight: 500; }
  .search { position: relative; display: flex; align-items: center; flex: 0 1 320px; }
  .search svg { position: absolute; left: 14px; }
  .search input { padding-left: 42px; height: 44px; }
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 14px 20px; border-top: 1px solid var(--p-line-soft); }
  .posts :global(li:first-child) { border-top: 0; }
  .posts :global(.thumb) { width: 96px; height: 60px; flex: none; border-radius: 8px; object-fit: cover; background: var(--p-line-soft); display: grid; place-items: center; font-size: 11px; font-weight: 600; color: var(--p-muted); }
  .posts :global(.t) { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .posts :global(.t a) { font-size: 15px; font-weight: 600; color: var(--p-text); text-decoration: none; }
  .posts :global(.t a:hover) { color: var(--p-blue); }
  .posts :global(.t small) { font-size: 13px; color: var(--p-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .posts :global(.st) { width: 100px; }
  .posts :global(.dt) { width: 150px; font-size: 13px; color: var(--p-text-2); }
  .pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--p-line); font-size: 13px; color: var(--p-muted); }
</style>

<script>
  import { api, requireUser, escapeHtml } from '../../scripts/portal';

  type Row = { id: number; slug: string; title: string; image: string | null; state: 'published' | 'draft' | 'scheduled'; publish_at: number | null; published_at: number | null; updated_at: number };
  type Res = { posts: Row[]; total: number; page: number; pages: number; counts: Record<string, number> };

  const list = document.querySelector<HTMLUListElement>('[data-posts]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const err = document.querySelector<HTMLElement>('[data-error]')!;
  const qInput = document.querySelector<HTMLInputElement>('[data-q]')!;
  const prev = document.querySelector<HTMLButtonElement>('[data-prev]')!;
  const next = document.querySelector<HTMLButtonElement>('[data-next]')!;
  const range = document.querySelector<HTMLElement>('[data-range]')!;

  const params = new URLSearchParams(location.search);
  let tab = params.get('tab') || 'all';
  let page = Number(params.get('page') || 1);
  let q = params.get('q') || '';
  qInput.value = q;

  const date = (ts: number) => new Date(ts * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const dateTime = (ts: number) => new Date(ts * 1000).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  function badge(r: Row) {
    if (r.state === 'published') return '<span class="p-badge p-badge--green">Published</span>';
    if (r.state === 'scheduled') return '<span class="p-badge p-badge--blue">Scheduled</span>';
    return '<span class="p-badge p-badge--gray">Draft</span>';
  }
  function when(r: Row) {
    if (r.state === 'published' && r.published_at) return date(r.published_at);
    if (r.state === 'scheduled' && r.publish_at) return dateTime(r.publish_at);
    return 'Edited ' + date(r.updated_at);
  }

  function syncUrl() {
    const u = new URLSearchParams();
    if (tab !== 'all') u.set('tab', tab);
    if (page > 1) u.set('page', String(page));
    if (q) u.set('q', q);
    history.replaceState(null, '', u.toString() ? `?${u}` : location.pathname);
  }

  async function load() {
    syncUrl();
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
    try {
      const res = await api<Res>(`blog/list.php?tab=${tab}&page=${page}&q=${encodeURIComponent(q)}`);
      err.hidden = true;
      Object.entries(res.counts).forEach(([k, v]) => { const el = document.querySelector(`[data-count="${k}"]`); if (el) el.textContent = String(v); });
      list.innerHTML = res.posts.map((r) => `
        <li>
          ${r.image ? `<img class="thumb" src="${escapeHtml(r.image)}" alt="" loading="lazy">` : '<span class="thumb">No image</span>'}
          <span class="t"><a href="/portal/post?id=${r.id}">${escapeHtml(r.title)}</a><small>/${escapeHtml(r.slug)}</small></span>
          <span class="st">${badge(r)}</span>
          <span class="dt">${escapeHtml(when(r))}</span>
          <a class="p-btn p-btn--sm" href="/portal/post?id=${r.id}">Edit</a>
        </li>`).join('');
      empty.hidden = res.posts.length > 0;
      const start = res.total ? (res.page - 1) * 20 + 1 : 0;
      range.textContent = res.total ? `Showing ${start}–${start + res.posts.length - 1} of ${res.total}` : '';
      prev.disabled = res.page <= 1;
      next.disabled = res.page >= res.pages;
    } catch (e) {
      err.textContent = (e as Error).message;
      err.hidden = false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab!; page = 1; load(); }));
  prev.addEventListener('click', () => { page = Math.max(1, page - 1); load(); });
  next.addEventListener('click', () => { page += 1; load(); });
  let t: number | undefined;
  qInput.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { q = qInput.value.trim(); page = 1; load(); }, 250); });

  requireUser().then(load);
</script>
